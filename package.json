{
  "name": "nuvio-regional-catalog",
  "version": "1.0.0",
  "private": true,
  "description": "TMDB-powered Tamil, Telugu, Malayalam and Kannada catalogs for Nuvio.",
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "build:collections": "node scripts/build-collections.mjs",
    "build:presets": "node scripts/build-presets.mjs",
    "build:manifest": "node scripts/build-catalogs.mjs --manifest-only && node scripts/build-presets.mjs",
    "build:catalogs": "node scripts/build-catalogs.mjs",
    "build": "npm run build:collections && npm run build:catalogs && node scripts/build-presets.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0"
  }
}
