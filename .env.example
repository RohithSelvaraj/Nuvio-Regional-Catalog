# Keep your real .env file private. Never commit an actual API key or access token.
# Option A: TMDB API v3 key (use only in your local .env file)
TMDB_API_KEY=PASTE_YOUR_TMDB_API_KEY_HERE

# Option B: TMDB API Read Access Token (Bearer token); takes priority if set.
TMDB_READ_ACCESS_TOKEN=PASTE_YOUR_TMDB_READ_ACCESS_TOKEN_HERE
