# Keep your real .env file private. Never commit your API key or access token.
# Option A: TMDB API Key (v3 key), copied from TMDB account settings:
TMDB_API_KEY=PASTE_YOUR_TMDB_API_KEY_HERE

# Option B: TMDB API Read Access Token (Bearer token). If set, this takes priority.
# TMDB_READ_ACCESS_TOKEN=PASTE_YOUR_TMDB_READ_ACCESS_TOKEN_HERE
